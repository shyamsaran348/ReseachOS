# Application Configuration
APP_NAME=ResearchOS
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-a-32-byte-hex-string

# Database & Vector Store (Local PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchos
PGVECTOR_DIMENSION=384 # 384 for all-MiniLM-L6-v2 (100% free local embeddings)

# AI & Embedding Providers (Free Stack)
LLM_PROVIDER=groq # Uses Groq API (Free Tier: 14.4k requests/day, 30 RPM)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile # or llama-3.1-8b-instant

# Embeddings (100% Free local CPU/GPU model)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2 # 384 dimensions, fast & lightweight

# Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_MB=50

# CORS & Server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_PORT=8000
